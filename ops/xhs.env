HOME=/home/user
USER=user
# xhs 容器运行时配置（非密钥；密钥仍在 scripts/.env，随项目挂载）
DISPLAY=:99
CHROME_BIN=/usr/bin/google-chrome-stable
CHROME_FORCE_HEADED=1
CHROME_EXTRA_FLAGS=--no-sandbox --disable-dev-shm-usage --disable-gpu --window-size=1440,900 --lang=zh-CN
XHS_PROFILES_BASE=/data/chrome-profiles
SQLITE_PATH=/home/user/PG/XiaohongshuSkills/data/news_dev.db
XHS_WEBAPI_BASE=http://127.0.0.1:5000
XHS_TMP_DIR=/home/user/PG/XiaohongshuSkills/tmp
USE_PROXY=0
NO_PROXY=127.0.0.1,localhost
no_proxy=127.0.0.1,localhost
CDP_NO_LOGIN_FALLBACK=1
TZ=Asia/Shanghai
